# Rows, done-markers, checkpoints and manifests are checked by their sha256 (scripts/automation/common.py,
# unit_done), so git must never rewrite their line endings on any machine.
runs/** -text
jobs/** -text
# shell scripts run in Git Bash on Windows, which cannot run them with CRLF line endings
*.sh text eol=lf
# GVGAI files are vendored byte for byte from the upstream commit; git must not rewrite their line endings
third_party/gvgai/** -text
# study 1 files and their vendored external code are copied byte for byte; git must not rewrite their line endings
third_party/study1/** -text
